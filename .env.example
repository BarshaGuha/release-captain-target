# Copy to .env and fill in for local development.

# Shared secret required in the `x-api-key` header for POST/PUT/DELETE
# requests to /api/todos. If unset, write endpoints are unprotected —
# fine for a quick local test, never for a deployed instance.
API_KEY=change-me

# Where SQLite stores the todos file. Leave unset (or ":memory:") to keep
# data only for the life of the process — matches v1.1.0 behavior.
TODO_DB_PATH=./data/todos.sqlite
